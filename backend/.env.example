# ═══════════════════════════════════════════════════════════════════════════════
# StudyLoG.AI Backend - Environment Variables Example
# ═══════════════════════════════════════════════════════════════════════════════
#
# This file documents all environment variables and secrets used by StudyLoG.AI
# backend workers. Copy this file to .env.local for local development.
#
# IMPORTANT: .env.local should NEVER be committed to version control.
#
# ═══════════════════════════════════════════════════════════════════════════════
# Secret Management Best Practices
# ═══════════════════════════════════════════════════════════════════════════════
#
# Cloudflare Workers Secrets (Production):
#   - Use `wrangler secret put <KEY>` to set encrypted secrets at deploy time
#   - Secrets are encrypted and never exposed in worker code
#   - Each worker has its own set of secrets
#   - Example: cd workers/multi-model-router && wrangler secret put OPENAI_API_KEY
#
# Local Development:
#   - Copy this file to .env.local and fill in your values
#   - .env.local is loaded automatically by wrangler in dev mode
#   - Never commit .env.local to version control
#
# CI/CD:
#   - Use your CI platform's secret management (GitHub Secrets, etc.)
#   - Pass secrets via: wrangler secret put <KEY> <<<$SECRET_VALUE
#
# ═══════════════════════════════════════════════════════════════════════════════
# Table of Contents
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. Cloudflare Account (Optional - for cross-worker operations)
# 2. Multi-Model Router Secrets
# 3. First-Mile Router Secrets
# 4. G-Assist API Secrets
# 5. Resource IDs (D1, KV namespaces)
# 6. External Service URLs
# 7. Local Development Settings
#
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# 1. Cloudflare Account Settings
# ═══════════════════════════════════════════════════════════════════════════════
# Optional: For operations across multiple workers or accounts

# Cloudflare Account ID (found in dashboard URL)
# Format: 32-character hex string
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# ═══════════════════════════════════════════════════════════════════════════════
# 2. Multi-Model Router Secrets
# ═══════════════════════════════════════════════════════════════════════════════
# Worker: backend/workers/multi-model-router
#
# These are API keys for LLM providers. Only configure providers you have
# access to. The router will use available providers in the fallback chain.

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
# Models: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# MULTI_MODEL_OPENAI_API_KEY=sk-...

# Anthropic API Key
# Get from: https://console.anthropic.com/
# Models: claude-3-5-sonnet, claude-3-5-haiku, claude-3-opus
# MULTI_MODEL_ANTHROPIC_API_KEY=sk-ant-...

# Google AI API Key
# Get from: https://makersuite.google.com/app/apikey
# Models: gemini-1.5-pro, gemini-1.5-flash
# MULTI_MODEL_GOOGLE_API_KEY=AIza...

# NVIDIA API Key
# Get from: https://build.nvidia.com/
# Models: llama-3.1-405b, nemotron-4-340b
# MULTI_MODEL_NVIDIA_API_KEY=nvapi-...

# ═══════════════════════════════════════════════════════════════════════════════
# 3. First-Mile Router Secrets
# ═══════════════════════════════════════════════════════════════════════════════
# Worker: backend/workers/first-mile-router
#
# Optional: API keys for fallback when Workers AI is unavailable.
# In most cases, Workers AI (@cf/meta/llama-3.3-70b-instruct-fp8-fast) is
# sufficient for intent classification.

# FIRST_MILE_OPENAI_API_KEY=sk-...
# FIRST_MILE_ANTHROPIC_API_KEY=sk-ant-...
# FIRST_MILE_GOOGLE_API_KEY=AIza...
# FIRST_MILE_NVIDIA_API_KEY=nvapi-...

# ═══════════════════════════════════════════════════════════════════════════════
# 4. G-Assist API Secrets
# ═══════════════════════════════════════════════════════════════════════════════
# Worker: backend/workers/g-assist-api
#
# Optional: Only needed if using external providers directly.
# Normally handled by multi-model-router.

# G_ASSIST_ANTHROPIC_API_KEY=sk-ant-...
# G_ASSIST_OPENAI_API_KEY=sk-...

# ═══════════════════════════════════════════════════════════════════════════════
# 5. Resource IDs (D1, KV)
# ═══════════════════════════════════════════════════════════════════════════════
# These IDs are output by setup-d1.sh and setup-kv.sh scripts.
# Update wrangler.toml files with these values after running the setup scripts.

# D1 Database IDs
# STUDYLOG_MAIN_D1_ID=your_d1_database_id
# MULTI_MODEL_COSTS_D1_ID=your_d1_database_id
# G_ASSIST_CONVERSATIONS_D1_ID=your_d1_database_id
# STUDENT_STATE_D1_ID=your_d1_database_id
# SLEEP_TRAINER_D1_ID=your_d1_database_id

# KV Namespace IDs
# CLASSIFICATION_CACHE_KV_ID=your_kv_namespace_id
# ROUTER_CACHE_KV_ID=your_kv_namespace_id
# ASSISTANT_CACHE_KV_ID=your_kv_namespace_id
# RATE_LIMITS_KV_ID=your_kv_namespace_id

# ═══════════════════════════════════════════════════════════════════════════════
# 6. External Service URLs
# ═══════════════════════════════════════════════════════════════════════════════
# Worker URLs after deployment. Update these after running deploy.sh.

# Multi-Model Router URL
# MULTI_MODEL_ROUTER_URL=https://multi-model-router.studylog.workers.dev

# First-Mile Router URL
# FIRST_MILE_ROUTER_URL=https://first-mile-router.studylog.workers.dev

# G-Assist API URL
# G_ASSIST_API_URL=https://g-assist-api.studylog.workers.dev

# ═══════════════════════════════════════════════════════════════════════════════
# 7. Local Development Settings
# ═══════════════════════════════════════════════════════════════════════════════
# Settings for local development with wrangler dev

# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: debug, info, warn, error
LOG_LEVEL=debug

# Ollama local URL (for local model testing)
OLLAMA_URL=http://localhost:11434

# Enable cascade routing (intent-based classification)
# Set to "true" to enable, omit or "false" to disable
CASCADING_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════════
# 8. RTX AI PC Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Settings for local RTX GPU inference and STEM acceleration

# Enable RTX local inference (requires RTX GPU and local bridge)
RTX_LOCAL_ENABLED=false

# RTX local bridge URL (default: localhost:8080)
RTX_LOCAL_BRIDGE_URL=http://localhost:8080

# Minimum GPU memory threshold for local inference (in bytes)
# Default: 8GB - only use local GPU if at least this much VRAM available
RTX_GPU_MEMORY_THRESHOLD=8589934592

# TensorRT installation path (for local bridge)
# Only needed if setting up local TensorRT inference
TENSORRT_PATH=/usr/local/TensorRT

# Prefer local inference when available
# Set to "true" to always prefer local RTX inference over cloud APIs
RTX_PREFER_LOCAL=true

# Automatically detect and use RTX GPU
# Set to "false" to disable automatic GPU detection
RTX_AUTO_DETECT=true

# ═══════════════════════════════════════════════════════════════════════════════
# 9. STEM Tools Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Settings for Python-based STEM acceleration tools (CuPy, Numba)

# Enable CuPy GPU bridge for physics and data science
# Requires: Python bridge running on configured port
CUPY_ENABLED=false

# CuPy bridge URL (default: localhost:8081)
CUPY_BRIDGE_URL=http://localhost:8081

# Enable Numba CUDA kernels for high-performance computing
# Requires: Python bridge running on configured port
NUMBA_ENABLED=false

# Numba bridge URL (default: localhost:8082)
NUMBA_BRIDGE_URL=http://localhost:8082

# Python bridge path (for local spawning)
# Absolute path to the Python bridge scripts
PYTHON_BRIDGE_PATH=./workers/stem

# Python executable to use for bridges
# Default: python3 or python (depending on system)
PYTHON_EXECUTABLE=python3

# GPU offload threshold (in milliseconds)
# Tasks taking longer than this will be offloaded to GPU if available
GPU_OFFLOAD_THRESHOLD_MS=100

# Physics simulation settings
PHYSICS_DEFAULT_DT=0.016
PHYSICS_DEFAULT_STEPS=1
PHYSICS_DEFAULT_DAMPING=0.99

# ═══════════════════════════════════════════════════════════════════════════════
# 10. Godot Physics Bridge Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Settings for Godot engine integration with GPU acceleration

# Enable Godot physics bridge
GODOT_PHYSICS_BRIDGE_ENABLED=false

# Godot physics bridge URL (for communication with Godot)
GODOT_PHYSICS_BRIDGE_URL=http://localhost:8083

# WebSocket port for real-time Godot updates
GODOT_WEBSOCKET_PORT=8084

# Enable GPU acceleration for Godot physics
GODOT_GPU_ACCELERATION_ENABLED=false

# ═══════════════════════════════════════════════════════════════════════════════
# Setup Instructions
# ═══════════════════════════════════════════════════════════════════════════════
#
# First Time Setup:
#
# 1. Install Wrangler CLI:
#    npm install -g wrangler
#
# 2. Authenticate with Cloudflare:
#    wrangler login
#
# 3. Create resources:
#    ./scripts/setup-d1.sh     # Creates D1 databases
#    ./scripts/setup-kv.sh     # Creates KV namespaces
#
# 4. Update wrangler.toml files:
#    - Copy the database and namespace IDs from the setup script output
#    - Replace placeholder IDs in each worker's wrangler.toml
#
# 5. Set secrets (for each worker):
#    cd workers/multi-model-router
#    wrangler secret put OPENAI_API_KEY
#    wrangler secret put ANTHROPIC_API_KEY
#    # etc.
#
# 6. Deploy:
#    ./scripts/deploy.sh
#
# Local Development:
#
# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Fill in your API keys and local settings
#
# 3. Run worker in dev mode:
#    cd workers/first-mile-router
#    wrangler dev
#
# ═══════════════════════════════════════════════════════════════════════════════
