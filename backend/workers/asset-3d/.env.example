# 3D Asset API - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================================
# Provider API Keys
# ============================================================================

# Tencent Hunyuan 3D
# Sign up at: https://hunyuan.tencent.com/en
HUNYUAN_API_KEY=your_hunyuan_api_key_here

# Sloyd AI
# Sign up at: https://sloyd.ai
SLOYD_API_KEY=your_sloyd_api_key_here

# Masterpiece X
# Sign up at: https://masterpiecex.com
MASTERPIECE_X_API_KEY=your_masterpiece_x_api_key_here

# Tripo AI
# Sign up at: https://tripo.ai
TRIPO_API_KEY=your_tripo_api_key_here

# Rodin Gen-2
# Sign up at: https://rodin.ai
RODIN_API_KEY=your_rodin_api_key_here

# Meshy AI
# Sign up at: https://meshy.ai
MESHY_API_KEY=your_meshy_api_key_here

# ============================================================================
# Cloudflare Services
# ============================================================================

# KV Namespace for caching
# Create with: wrangler kv:namespace create ASSET_3D_CACHE
KV_NAMESPACE_ID=your_kv_namespace_id

# D1 Database for asset metadata
# Create with: wrangler d1 create studylog-assets-3d
D1_DATABASE_ID=your_d1_database_id

# R2 Bucket for asset storage
# Create with: wrangler r2 bucket create studylog-3d-assets
R2_BUCKET_NAME=studylog-3d-assets

# ============================================================================
# Optional Configuration
# ============================================================================

# Default quality tier for generations (draft, preview, standard, high, ultra)
DEFAULT_QUALITY=standard

# Maximum concurrent generations
MAX_CONCURRENT_REQUESTS=10

# Asset storage path (for Godot imports)
ASSETS_PATH=res://assets/models/

# Enable/disable providers
HUNYUAN_ENABLED=true
SLOYD_ENABLED=true
MASTERPIECE_X_ENABLED=true
TRIPO_ENABLED=true
RODIN_ENABLED=true
MESHY_ENABLED=true

# ============================================================================
# Pricing Configuration (USD)
# ============================================================================

# Maximum cost per generation
MAX_COST_PER_GENERATION=1.00

# Monthly budget limit
MONTHLY_BUDGET_LIMIT=100.00

# ============================================================================
# Logging
# ============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true
