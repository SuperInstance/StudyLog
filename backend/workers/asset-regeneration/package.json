{
  "name": "@studylog/asset-regeneration",
  "version": "1.0.0",
  "description": "Asset Regeneration System - Convert assets between MicroVerse (2D), Luanti (Voxel), and OpenRTS (3D Mesh) forms",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "asset",
    "regeneration",
    "sprite",
    "voxel",
    "mesh",
    "3d",
    "2d",
    "gamedev",
    "microverse",
    "luanti",
    "openrts"
  ],
  "author": "SuperInstance.AI",
  "license": "MIT"
}
