{
  "name": "@studylog/engine-abstraction",
  "version": "1.0.0",
  "description": "Unified game engine abstraction layer for MicroVerse, Luanti, and OpenRTS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "game-engine",
    "abstraction",
    "microverse",
    "luanti",
    "openrts",
    "godot",
    "cross-platform"
  ],
  "author": "SuperInstance.AI",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
