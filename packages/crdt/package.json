{
  "name": "@studylog/crdt",
  "version": "1.0.0",
  "description": "CRDT (Conflict-free Replicated Data Types) implementation for StudyLoG.AI real-time collaboration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js"
    },
    "./counters": {
      "types": "./dist/counters.d.ts",
      "import": "./dist/counters.js"
    },
    "/sets": {
      "types": "./dist/sets.d.ts",
      "import": "./dist/sets.js"
    },
    "/register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "crdt",
    "collaboration",
    "real-time",
    "offline-first",
    "conflict-free",
    "replicated",
    "data-types"
  ],
  "author": "SuperInstance.AI",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}
