  "types": "lib/common/index.d.ts",
  "dependencies": {
    "@theia/core": "1.54.0",
    "@theia/editor": "1.54.0",
    "@theia/messages": "1.54.0",
    "@theia/monaco": "1.54.0",
    "@theia/workspace": "1.54.0",
