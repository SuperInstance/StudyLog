{
  "name": "@studylog/si-digital-tutor",
  "version": "0.1.0",
  "description": "AI-Powered Digital Tutor with NVIDIA ACE integration for StudyLoG.AI",
  "license": "MIT",
  "keywords": [
    "theia-extension",
    "digital-human",
    "nvidia",
    "ace",
    "avatar",
    "tutor",
    "studylog"
  ],
  "files": [
    "lib",
    "src"
  ],
  "main": "lib/common/index.js",
  "types": "lib/common/index.d.ts",
  "dependencies": {
    "@theia/core": "1.54.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1",
    "vitest": "^2.1.8",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "jsdom": "^25.0.1",
    "@types/jsdom": "^21.1.7"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/si-digital-tutor-frontend-module"
    }
  ]
}
