{
  "name": "@studylog/electron-app",
  "version": "0.1.0",
  "private": true,
  "description": "StudyLoG.AI Electron Application",
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@theia/core": "1.54.0",
    "@theia/editor": "1.54.0",
    "@theia/filesystem": "1.54.0",
    "@theia/monaco": "1.54.0",
    "@theia/navigator": "1.54.0",
    "@theia/outline-view": "1.54.0",
    "@theia/preferences": "1.54.0",
    "@theia/terminal": "1.54.0",
    "@theia/workspace": "1.54.0",
    "@theia/messages": "1.54.0",
    "@theia/electron": "1.54.0",
    "@studylog/si-godot-embed": "0.1.0",
    "@studylog/si-a2ui-renderer": "0.1.0",
    "@studylog/si-agent-director": "0.1.0",
    "@studylog/si-cognitive-mill": "0.1.0",
    "@studylog/si-sitka-sound": "0.1.0",
    "@studylog/si-intelligence-ranch": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.54.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "scripts": {
    "clean": "theia clean",
    "build": "theia build --mode development",
    "build:prod": "theia build --mode production",
    "start": "electron .",
    "watch": "theia build --watch --mode development",
    "package": "electron-builder -mwl"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "StudyLoG.AI",
        "preferences": {
          "workbench.colorTheme": "dark"
        }
      }
    },
    "backend": {
      "config": {}
    }
  },
  "build": {
    "appId": "ai.studylog.ide",
    "productName": "StudyLoG.AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "lib/**/*",
      "src-gen/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns"
    },
    "win": {
      "icon": "assets/icon.ico"
    },
    "linux": {
      "category": "Development",
      "icon": "assets/icon.png",
      "target": ["AppImage", "deb"]
    }
  }
}
